---
import screenCss from '../styles/all.scss?url';
import printCss from '../styles/print.scss?url';

interface Props {
  title?: string;
  // Set when used as a Markdown page layout.
  frontmatter?: { title?: string };
}

const { title = Astro.props.frontmatter?.title ?? 'JPoz.net' } = Astro.props;
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="/fontawesome/css/all.css" rel="stylesheet"> <!--load all styles -->
    <link href={screenCss} rel="stylesheet" media="screen">
    <link href={printCss} rel="stylesheet" media="print">

    <title>{title}</title>
    <script is:inline src="/javascripts/site.js"></script>
  </head>
  <body>
    <main>
      <slot />
    </main>

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-K7ZEMM6EGS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-K7ZEMM6EGS');
    </script>
  </body>
</html>
