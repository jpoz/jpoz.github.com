---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const entry = (await getEntry('about', '-index'))!;
const { Content } = await render(entry);
const { title, meta_title, image, what_i_do } = entry.data;
---

<BlogLayout title={meta_title || 'About'} image={image} section="About">
  <div class="wrap">
    <section class="about-grid">
      {image && (
        <figure class="plate panel">
          <img src={image} alt="James Pozdena" />
        </figure>
      )}
      <div>
        <div class="label" style="margin-bottom:18px">About</div>
        <h1>{title}</h1>
        <div class="prose"><Content /></div>
      </div>
    </section>

    {what_i_do && (
      <section class="spec">
        <div class="section-label" style="margin:0">{what_i_do.title} <span>{what_i_do.items.length}</span></div>
        <dl>
          {what_i_do.items.map((item, i) => (
            <div>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <dt>{item.title}</dt>
              <dd>{item.description}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}
  </div>
</BlogLayout>
