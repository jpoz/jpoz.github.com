---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, taxonomy } from '../../lib/posts';

export async function getStaticPaths() {
  return taxonomy(await getPosts(), 'categories').map((t) => ({ params: { category: t.slug }, props: { term: t } }));
}

const { term } = Astro.props;
---

<BlogLayout title={term.name}>
  <div class="wrap">
    <section class="intro">
      <div class="label"><a href="/categories" style="color:inherit;text-decoration:none">← Categories</a><span>{term.posts.length} {term.posts.length === 1 ? 'post' : 'posts'}</span></div>
      <h1>{term.name}</h1>
    </section>
    <div class="section-label">Posts <span>Categories / {term.name}</span></div>
    <PostList posts={term.posts} />
  </div>
</BlogLayout>
