---
// 2013-2017 posts from the old jpoz.net.
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { formatDate, legacyDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = legacyDate(post);
---

<BlogLayout title={post.data.title} section="Archive" noindex={post.data.published === false}>
  <article class="narrow">
    <header class="post-head">
      <div class="meta">
        <a href="/blog">← Writing</a>
        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
        <span class="right">Archive</span>
      </div>
      <h1>{post.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BlogLayout>
