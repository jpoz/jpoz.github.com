<style is:global>
  :root {
    --paper: #EFE8E7;
    --ink: #2A292C;
    --ink-2: #6B6668;
    --ink-3: #9A9395;
    --rule: rgba(42, 41, 44, 0.22);
    --dots: rgba(42, 41, 44, 0.35);
    --mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    --inset: 24px;
    --py: 22px;
    --px: 22px;
    --sat: env(safe-area-inset-top, 0px);
    --sab: env(safe-area-inset-bottom, 0px);
    --sal: env(safe-area-inset-left, 0px);
    --sar: env(safe-area-inset-right, 0px);
  }
  :root.kb { --sab: 0px; }
  :root.night {
    --paper: #1D1C1F;
    --ink: #E9E2E1;
    --ink-2: #A8A1A3;
    --ink-3: #6E686A;
    --rule: rgba(233, 226, 225, 0.18);
    --dots: rgba(233, 226, 225, 0.22);
  }

  *, *::before, *::after { box-sizing: border-box; }

  html, body { margin: 0; height: 100%; }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.55;
    overflow: hidden;
    transition: background 0.3s, color 0.3s;
  }

  .dim { color: var(--ink-3); }
  b { font-weight: 500; }
  a { color: inherit; }

  /* ---------- frame (same as the homepage) ---------- */

  .frame {
    position: fixed;
    top: calc(var(--vvt, 0px) + var(--inset) + var(--sat));
    bottom: calc(var(--vvb, 0px) + var(--inset) + var(--sab));
    left: calc(var(--inset) + var(--sal));
    right: calc(var(--inset) + var(--sar));
    z-index: 3;
    pointer-events: none;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .corner { position: absolute; width: 18px; height: 18px; border: 0 solid var(--ink); }
  .corner.tl { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
  .corner.tr { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; }
  .corner.bl { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; }
  .corner.br { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }
  .edge { position: absolute; background: var(--paper); padding: 1px 6px; font-variant-numeric: tabular-nums; transition: background 0.3s; }
  .edge span { color: var(--ink-3); }
  .edge a { pointer-events: auto; text-decoration: none; color: var(--ink-2); }
  .edge a:hover { color: var(--ink); }
  .edge.top-left { top: 4px; left: 30px; }
  .edge.top-right { top: 4px; right: 30px; }

  /* ---------- layout ---------- */

  .console {
    position: fixed;
    top: calc(var(--vvt, 0px) + var(--inset) + var(--sat) + var(--py));
    bottom: calc(var(--vvb, 0px) + var(--inset) + var(--sab) + var(--py));
    left: calc(var(--inset) + var(--sal) + var(--px));
    right: calc(var(--inset) + var(--sar) + var(--px));
    display: flex;
    justify-content: center;
  }
  .panel {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--rule);
    min-height: 0;
    transition: background 0.3s;
  }
  /* halftone drop shadow, like the homepage cards */
  .panel::before {
    content: '';
    position: absolute;
    inset: -1px;
    transform: translate(8px, 8px);
    z-index: -1;
    background-image: radial-gradient(circle, var(--dots) 1.1px, transparent 1.6px), radial-gradient(circle, var(--dots) 1.1px, transparent 1.6px);
    background-size: 6px 6px;
    background-position: 0 0, 3px 3px;
  }
  .panel > header {
    display: flex;
    gap: 14px;
    padding: 7px 12px;
    border-bottom: 1px solid var(--rule);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .panel > header { justify-content: center; text-transform: none; letter-spacing: 0.04em; color: var(--ink-3); }

  /* ---------- terminal ---------- */

  .term { display: flex; flex-direction: column; width: min(100%, 980px); }
  .out {
    flex: 1;
    overflow-y: auto;
    padding: 14px 16px 4px;
    scrollbar-width: thin;
    scrollbar-color: var(--rule) transparent;
  }
  .out > div { white-space: pre-wrap; word-break: break-word; min-height: 1.55em; }
  .out .pre { white-space: pre; overflow-x: auto; }
  .out .row { display: block; padding-left: var(--hang); text-indent: calc(-1 * var(--hang)); }
  .out .err { color: var(--ink); }
  .out .err::before { content: '! '; color: var(--ink-3); }
  .out .warn { color: var(--ink-2); }
  .out .echo { margin-top: 6px; }
  .out a { text-underline-offset: 3px; text-decoration-color: var(--ink-3); }
  .out a:hover { text-decoration-color: var(--ink); }
  .cmd {
    font: inherit;
    color: var(--ink);
    background: none;
    border: none;
    border-bottom: 1px dashed var(--ink-3);
    padding: 0;
    cursor: pointer;
  }
  .cmd:hover, .cmd:focus-visible {
    outline: none;
    background-image: radial-gradient(circle, var(--dots) 1px, transparent 1.5px), radial-gradient(circle, var(--dots) 1px, transparent 1.5px);
    background-size: 6px 6px;
    background-position: 0 0, 3px 3px;
  }
  .portrait { font-size: 6px; line-height: 1; letter-spacing: 0; color: var(--ink); overflow-x: auto; }

  .line {
    display: flex;
    gap: 9px;
    align-items: baseline;
    padding: 10px 16px 12px;
    border-top: 1px solid var(--rule);
    cursor: text;
  }
  .line .ps1 { color: var(--ink-3); white-space: nowrap; }
  .line input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: max(12.5px, 16px * var(--touch, 0)); /* avoid iOS zoom-on-focus, see media query */
    color: var(--ink);
    background: none;
    border: none;
    outline: none;
    caret-color: var(--ink);
    padding: 0;
  }
  .line.busy input { opacity: 0.3; }

  .keys { display: none; }
  .line.busy .ps1::after { content: ' ...'; animation: blink 0.8s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* ---------- shutdown ---------- */

  .halt {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 18px;
    background: #111;
    color: #8a8486;
    font-size: 13px;
    letter-spacing: 0.04em;
    animation: off 0.5s ease-in;
  }
  .halt[hidden] { display: none; }
  .halt button {
    font: inherit;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #cfc8c7;
    background: none;
    border: 1px solid #555;
    padding: 8px 16px;
    cursor: pointer;
  }
  .halt button:hover, .halt button:focus-visible { border-color: #cfc8c7; outline: none; }
  @keyframes off {
    0% { clip-path: inset(0 0 0 0); background: #fff; }
    40% { clip-path: inset(49.5% 0 49.5% 0); background: #fff; }
    100% { clip-path: inset(0 0 0 0); background: #111; }
  }

  /* ---------- narrow ---------- */

  @media (max-width: 860px) {
    :root { --inset: 12px; --py: 18px; --px: 6px; --touch: 1; }
    :root.kb { --inset: 4px; --py: 16px; }
    .out { padding: 12px 12px 4px; font-size: 11.5px; }
    .line { padding: 9px 12px 11px; }
    /* 97 columns, scaled to fit the width of the output */
    .portrait { font-size: clamp(2.6px, (100vw - 80px) / 58, 6px); }
  }

  /* ---------- touch ---------- */

  @media (hover: none) and (pointer: coarse) {
    :root { --touch: 1; }
    body { -webkit-tap-highlight-color: transparent; }
    .out { line-height: 1.75; }
    .out .cmd { touch-action: manipulation; }
    .line { border-bottom: 1px solid var(--rule); }
    .keys {
      display: flex;
      gap: 6px;
      padding: 8px 12px;
      overflow-x: auto;
      scrollbar-width: none;
