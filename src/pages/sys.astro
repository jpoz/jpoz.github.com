    .keys::-webkit-scrollbar { display: none; }
    .keys button {
      flex: none;
      min-width: 40px;
      min-height: 34px;
      padding: 0 11px;
      font: inherit;
      font-size: 12px;
      color: var(--ink-2);
      background: none;
      border: 1px solid var(--rule);
      border-radius: 0;
      touch-action: manipulation;
    }
    .keys button:active {
      color: var(--ink);
      background-image: radial-gradient(circle, var(--dots) 1px, transparent 1.5px), radial-gradient(circle, var(--dots) 1px, transparent 1.5px);
      background-size: 6px 6px;
      background-position: 0 0, 3px 3px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .halt { animation: none; }
  }
</style>
